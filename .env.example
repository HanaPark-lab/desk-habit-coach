# 사용법: cp .env.example .env  후 replace-me 값을 바꾼다. .env는 Git에 올리지 않는다.
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Seoul

POSTGRES_DB=desk_habit
POSTGRES_USER=desk_habit
POSTGRES_PASSWORD=replace-me
DATABASE_HOST=localhost
DATABASE_PORT=5442

REDIS_HOST_PORT=6389
REDIS_URL=redis://localhost:6389/0
FASTAPI_URL=http://localhost:8001
FASTAPI_TIMEOUT=180

# 허용 카메라: CAMERA_<별칭>_URL. 휴대폰 IP Webcam 앱의 영상 주소 (예: http://<휴대폰 IP>:8080/video)
CAMERA_DESK_CAM_1_URL=
DEFAULT_CAPTURE_SECONDS=8
MAX_UPLOAD_MB=50

# 행동 기록 기준값 (training/train_rf.py 보고서 docs/TRAINING_REPORT.md 의 제안값)
EVENT_THRESHOLD_DRINK=0.5
EVENT_THRESHOLD_MOVEMENT=0.5
# 하루 순공 목표(분)
STUDY_GOAL_MINUTES=360
