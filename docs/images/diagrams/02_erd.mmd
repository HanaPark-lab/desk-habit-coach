erDiagram
 USER {
  int id PK
  string username
  datetime date_joined
  datetime last_login
 }
 DAILY_USER_ACTIVITY {
  bigint id PK
  int user_id FK
  date day
  boolean logged_in
  datetime last_seen_at
 }
 STUDY_SESSION {
  uuid id PK
  int user_id FK
  string status
  string mode
  datetime started_at
  datetime ended_at
 }
 ANALYSIS_JOB {
  uuid id PK
  int user_id FK
  uuid session_id FK
  string input_type
  string status
  string video_file
  string model_version
  string error_code
  datetime created_at
 }
 STUDY_INTERVAL {
  bigint id PK
  uuid session_id FK
  string state
  string source
  datetime started_at
  datetime ended_at
 }
 PERSON_PREDICTION {
  bigint id PK
  uuid job_id FK
  int track_id
  string action_label
  float confidence
  json probabilities
 }
 BEHAVIOR_EVENT {
  uuid id PK
  int user_id FK
  uuid session_id FK
  uuid job_id FK
  string event_type
  string action_label
  float confidence
  datetime occurred_at
  boolean is_valid
 }
 USER ||--o{ DAILY_USER_ACTIVITY : relates
 USER ||--o{ STUDY_SESSION : relates
 USER ||--o{ ANALYSIS_JOB : relates
 USER ||--o{ BEHAVIOR_EVENT : relates
 STUDY_SESSION ||--o{ STUDY_INTERVAL : relates
 STUDY_SESSION |o--o{ ANALYSIS_JOB : relates
 STUDY_SESSION |o--o{ BEHAVIOR_EVENT : relates
 ANALYSIS_JOB ||--o{ PERSON_PREDICTION : relates
 ANALYSIS_JOB |o--o{ BEHAVIOR_EVENT : relates
